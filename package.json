{
  "name": "ghostq",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "start": "next start -p 3300",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "prepare": "simple-git-hooks || true",
    "commitlint": "commitlint",
    "release-notes": "git-cliff --unreleased --tag \"${NEXT_TAG:?set NEXT_TAG, e.g. NEXT_TAG=v1.1.0}\""
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.147",
    "@aws-sdk/client-s3": "^3.1153.0",
    "@neondatabase/serverless": "^1.2.0",
    "ai": "^7.0.143",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "git-cliff": "2.14.2",
    "simple-git-hooks": "2.14.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.0.9",
  "simple-git-hooks": {
    "commit-msg": "pnpm exec commitlint --edit \"$1\""
  }
}
