# Copy to .env.local and fill in. Never commit .env.local.

# Qloo hackathon key (header X-Api-Key)
QLOO_API_KEY=
# QLOO_API_BASE_URL=https://hackathon.api.qloo.com

# Vercel AI Gateway: either an API key, or run `vercel link` then `vercel env pull` for VERCEL_OIDC_TOKEN
AI_GATEWAY_API_KEY=

# Spotify app (client credentials) for the artist search
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Google Gemini API key (paid tier) for Lyria singing: https://aistudio.google.com/apikey
GEMINI_API_KEY=
